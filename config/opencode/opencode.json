{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "artifacts": true
  },
  "provider": {
    "forge": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Forge (local GPU)",
      "options": {
        "baseURL": "http://127.0.0.1:8181/v1"
      },
      "models": {
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B (forge)",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "qwen3.5-9b-nothink": {
          "name": "Qwen3.5 9B no-think (forge)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    },
    "forge-inkling": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Forge Inkling (local CPU)",
      "options": {
        "baseURL": "http://127.0.0.1:8182/v1"
      },
      "models": {
        "inkling-2-mini": {
          "name": "Inkling 2 Mini (forge)",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "inkling-2-mini-nothink": {
          "name": "Inkling 2 Mini low-effort (forge)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "forge/qwen3.5-9b",
  "small_model": "forge/qwen3.5-9b-nothink",
  "mcp": {
    "servers": {}
  }
}
