layout {

    focus-ring {
        active-color   "#fab387"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    border {
        active-color   "#fab387"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }


    tab-indicator {
        active-color   "#fab387"
        inactive-color "#604a48"
        urgent-color   "#f38ba8"
    }

    insert-hint {
        color "#fab38780"
    }
}

recent-windows {
    highlight {
        active-color "#fab387"
        urgent-color "#f38ba8"
    }
}
